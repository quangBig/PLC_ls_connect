<Window x:Class="IndustrialVision.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:resources="clr-namespace:IndustrialVision.App.Resources"
        Title="{Binding ApplicationTitle}"
        Height="900" Width="1400"
        MinHeight="700" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#1E1E2E">

    <Window.Resources>
        <resources:ConnectionStatusToColorConverter x:Key="StatusToColor" />
        <resources:ConnectionStatusToTextConverter x:Key="StatusToText" />
        <resources:InspectionResultToColorConverter x:Key="ResultToColor" />
        <resources:MachineStateToTextConverter x:Key="StateToText" />
        <resources:BoolToVisibilityConverter x:Key="BoolToVis" />
        <resources:BoolToColorConverter x:Key="BoolToColor" />
        <resources:BoolToRedColorConverter x:Key="BoolToRedColor" />
        <resources:BoolToOrangeColorConverter x:Key="BoolToOrangeColor" />
        <resources:BoolToBlueColorConverter x:Key="BoolToBlueColor" />
        <resources:BoolToCyanColorConverter x:Key="BoolToCyanColor" />
        <resources:BoolToOnOffTextConverter x:Key="BoolToOnOffText" />
        <resources:NullableBoolToColorConverter x:Key="NullableBoolToColor" />

        <!-- Tab Styles -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#A6ADC8" />
            <Setter Property="Background" Value="#181825" />
            <Setter Property="BorderBrush" Value="#313244" />
            <Setter Property="BorderThickness" Value="1,1,1,0" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6,6,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#1E1E2E" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#89B4FA" />
                                <Setter Property="Foreground" Value="#89B4FA" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#313244" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Base Button Style -->
        <Style x:Key="HmiButton" TargetType="Button">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#3A3A5C" />
            <Setter Property="BorderBrush" Value="#50506E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#4A4A7C" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#2A2A4C" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Green Action Button -->
        <Style x:Key="ConnectButton" TargetType="Button" BasedOn="{StaticResource HmiButton}">
            <Setter Property="Background" Value="#2E7D32" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#388E3C" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Red Action Button -->
        <Style x:Key="DisconnectButton" TargetType="Button" BasedOn="{StaticResource HmiButton}">
            <Setter Property="Background" Value="#C62828" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D32F2F" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Status Indicator Style -->
        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <!-- ComboBox Dark Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1E1E2E" />
            <Setter Property="Foreground" Value="#CDD6F4" />
            <Setter Property="BorderBrush" Value="#45475A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="6,3" />
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#1E1E2E" />
            <Setter Property="Foreground" Value="#CDD6F4" />
            <Setter Property="Padding" Value="6,4" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#313244" />
                    <Setter Property="Foreground" Value="#89B4FA" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#45475A" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />      <!-- Header -->
            <RowDefinition Height="*" />          <!-- Main Content -->
            <RowDefinition Height="Auto" />       <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- ═══ HEADER ═══ -->
        <Border Grid.Row="0" Background="#16161E" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ApplicationTitle}"
                               FontSize="22" FontWeight="Bold" Foreground="#CDD6F4" />

                    <!-- Simulation Mode Indicator -->
                    <Border Background="#F57F17" CornerRadius="4" Padding="8,2" Margin="16,0,0,0"
                            Visibility="{Binding IsSimulationMode, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="SIMULATION" FontSize="12" FontWeight="Bold" Foreground="White" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="STATE: " Foreground="#A6ADC8" FontSize="14" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding MachineState, Converter={StaticResource StateToText}}"
                               Foreground="#CDD6F4" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ MAIN CONTENT ═══ -->
        <Grid Grid.Row="1" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />        <!-- Camera Image -->
                <ColumnDefinition Width="350" />      <!-- Right Panel -->
            </Grid.ColumnDefinitions>

            <!-- ── Left Side: Camera Image + Light Controller Panel ── -->
            <Grid Grid.Column="0" Margin="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />         <!-- Camera Image Area -->
                    <RowDefinition Height="Auto" />      <!-- Light Controller Panel -->
                </Grid.RowDefinitions>

                <!-- Camera Image Area -->
                <Border Grid.Row="0" Background="#11111B" CornerRadius="8" Margin="0,0,0,6"
                        BorderBrush="#313244" BorderThickness="1">
                    <Grid>
                        <Image Source="{Binding CameraImage}"
                               Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />

                        <!-- Overlay when no image -->
                        <TextBlock Text="NO IMAGE"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="24" Foreground="#45475A"
                                   Visibility="{Binding CameraImage, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                    </Grid>
                </Border>

                <!-- ── Bottom TabControl: Light Controller + PLC LS Manual Test ── -->
                <TabControl Grid.Row="1" Margin="0,4,0,0">
                    <TabItem Header="📷 CAMERA (HIKROBOT)">
                        <Border Background="#181825" Padding="14,10" BorderBrush="#313244" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="HIKROBOT CAMERA — GigE / USB3" Foreground="#CDD6F4" FontWeight="Bold" Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox ItemsSource="{Binding AvailableCameras}" SelectedItem="{Binding SelectedCamera}"
                                              IsEnabled="{Binding CanSelectCamera}" MinWidth="200" Margin="0,0,8,0" FontSize="12" />
                                    <Button Grid.Column="1" Content="DISCOVER" Command="{Binding DiscoverCamerasCommand}"
                                            Style="{StaticResource HmiButton}" Padding="10,5" />
                                </Grid>
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Content="CONNECT" Command="{Binding ConnectCameraCommand}" Style="{StaticResource ConnectButton}" Padding="10,5" Margin="0,0,4,0" />
                                    <Button Content="DISCONNECT" Command="{Binding DisconnectCameraCommand}" Style="{StaticResource DisconnectButton}" Padding="10,5" Margin="0,0,4,0" />
                                    <Button Content="LIVE" Command="{Binding StartLiveCommand}" Style="{StaticResource HmiButton}" Padding="10,5" Margin="0,0,4,0" />
                                    <Button Content="STOP LIVE" Command="{Binding StopLiveCommand}" Style="{StaticResource HmiButton}" Padding="10,5" Margin="0,0,4,0" />
                                    <Button Content="CAPTURE" Command="{Binding CaptureCommand}" Style="{StaticResource HmiButton}" Padding="10,5" />
                                </WrapPanel>
                                <WrapPanel Margin="0,10,0,0">
                                    <TextBlock Text="Exposure (µs):" Foreground="#A6ADC8" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBox Text="{Binding CameraExposure, UpdateSourceTrigger=LostFocus}" Width="90" Padding="5,3" Margin="0,0,12,0" />
                                    <TextBlock Text="Gain (dB):" Foreground="#A6ADC8" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBox Text="{Binding CameraGain, UpdateSourceTrigger=LostFocus}" Width="65" Padding="5,3" Margin="0,0,8,0" />
                                    <Button Content="APPLY" Command="{Binding ApplyCameraParametersCommand}" Style="{StaticResource HmiButton}" Padding="10,5" Margin="0,0,4,0" />
                                    <Button Content="SAVE SETTINGS" Command="{Binding SaveCameraSettingsCommand}" Style="{StaticResource HmiButton}" Padding="10,5" />
                                </WrapPanel>
                                <TextBlock Text="{Binding CameraMessage}" Foreground="#89B4FA" TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </TabItem>
                    <!-- Tab 1: Light Controller -->
                    <TabItem Header="💡 LIGHT CONTROLLER (RSEE 8CH)">
                        <Border Background="#181825" CornerRadius="0,8,8,8" Padding="14,10"
                                BorderBrush="#313244" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />  <!-- Header & Action Buttons -->
                                    <RowDefinition Height="Auto" />  <!-- Network Settings & Ping Bar -->
                                    <RowDefinition Height="Auto" />  <!-- Continuous Light Control -->
                                    <RowDefinition Height="Auto" />  <!-- 8 Channels UniformGrid -->
                                </Grid.RowDefinitions>

                                <!-- Panel Header & Quick Actions -->
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Title with Status Indicator -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="💡 LIGHT CONTROLLER" FontSize="14" FontWeight="Bold" Foreground="#CDD6F4" />
                                        <TextBlock Text=" (Rsee PW-D-24W20-8TE • 8CH LAN)" FontSize="12" Foreground="#A6ADC8" VerticalAlignment="Center" Margin="6,0,0,0" />
                                        <Ellipse Style="{StaticResource StatusDot}" Margin="12,0,4,0"
                                                 Fill="{Binding LightStatus, Converter={StaticResource StatusToColor}}" />
                                        <TextBlock Text="{Binding LightStatus, Converter={StaticResource StatusToText}}"
                                                   FontSize="11" FontWeight="Bold" Foreground="#A6ADC8" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Action Buttons -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="🔌 CONNECT" Command="{Binding ConnectLightCommand}"
                                                Style="{StaticResource ConnectButton}" Padding="10,4" FontSize="11" Margin="2" />
                                        <Button Content="⚡ TEST CH1-8" Command="{Binding CycleTestLightsCommand}"
                                                Style="{StaticResource HmiButton}" Padding="10,4" FontSize="11" Margin="2" />
                                        <Button Content="☀ ALL ON" Command="{Binding TurnOnAllLightsCommand}"
                                                Style="{StaticResource HmiButton}" Padding="10,4" FontSize="11" Margin="2" />
                                        <Button Content="🌑 ALL OFF" Command="{Binding TurnOffAllLightsCommand}"
                                                Style="{StaticResource DisconnectButton}" Padding="10,4" FontSize="11" Margin="2" />
                                    </StackPanel>
                                </Grid>

                                <!-- Network Settings & Ping Bar -->
                                <Border Grid.Row="1" Background="#11111B" CornerRadius="6" Padding="10,6" Margin="0,0,0,8"
                                        BorderBrush="#313244" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />  <!-- Label IP -->
                                            <ColumnDefinition Width="140" />   <!-- TextBox IP -->
                                            <ColumnDefinition Width="Auto" />  <!-- Label Port -->
                                            <ColumnDefinition Width="70" />    <!-- TextBox Port -->
                                            <ColumnDefinition Width="Auto" />  <!-- Ping Button -->
                                            <ColumnDefinition Width="Auto" />  <!-- Ping Status Badge -->
                                            <ColumnDefinition Width="Auto" />  <!-- Save Button -->
                                            <ColumnDefinition Width="*" />     <!-- Protocol info -->
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="IP:" Foreground="#A6ADC8" FontWeight="SemiBold" FontSize="12"
                                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBox Grid.Column="1" Text="{Binding LightIpAddress, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="#1E1E2E" Foreground="#CDD6F4" BorderBrush="#45475A" BorderThickness="1"
                                                 Padding="6,3" FontSize="12" VerticalAlignment="Center" FontFamily="Consolas" />

                                        <TextBlock Grid.Column="2" Text="Port:" Foreground="#A6ADC8" FontWeight="SemiBold" FontSize="12"
                                                   VerticalAlignment="Center" Margin="12,0,6,0" />
                                        <TextBox Grid.Column="3" Text="{Binding LightPort, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="#1E1E2E" Foreground="#CDD6F4" BorderBrush="#45475A" BorderThickness="1"
                                                 Padding="6,3" FontSize="12" VerticalAlignment="Center" FontFamily="Consolas" />

                                        <Button Grid.Column="4" Content="📡 PING" Command="{Binding PingLightCommand}"
                                                Style="{StaticResource HmiButton}" Padding="10,4" FontSize="11" Margin="10,0,6,0" />

                                        <Border Grid.Column="5" Background="{Binding IsPingSuccess, Converter={StaticResource NullableBoolToColor}}"
                                                CornerRadius="4" Padding="8,4" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding PingResultText}" FontSize="11" FontWeight="Bold" Foreground="White" />
                                        </Border>

                                        <Button Grid.Column="6" Content="💾 SAVE IP" Command="{Binding SaveLightSettingsCommand}"
                                                Style="{StaticResource HmiButton}" Padding="10,4" FontSize="11" Margin="2,0" />

                                        <TextBlock Grid.Column="7" Text="Protocol: ASCII (SA0000# - SH0255#)" Foreground="#585B70" FontSize="11"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0" />
                                    </Grid>
                                </Border>

                                <!-- Continuous Light Control (Điều Khiển Đèn Liên Tục: CH1..CH4 hoặc tùy chỉnh) -->
                                <Border Grid.Row="2" Background="#11111B" CornerRadius="6" Padding="10,8" Margin="0,0,0,8"
                                        BorderBrush="#313244" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />  <!-- Label + Tag -->
                                            <ColumnDefinition Width="Auto" />  <!-- Start Label -->
                                            <ColumnDefinition Width="70" />    <!-- ComboBox Start -->
                                            <ColumnDefinition Width="Auto" />  <!-- End Label -->
                                            <ColumnDefinition Width="70" />    <!-- ComboBox End -->
                                            <ColumnDefinition Width="Auto" />  <!-- Interval Label -->
                                            <ColumnDefinition Width="65" />    <!-- Interval TextBox -->
                                            <ColumnDefinition Width="Auto" />  <!-- ms -->
                                            <ColumnDefinition Width="Auto" />  <!-- Continuous ON Button -->
                                            <ColumnDefinition Width="Auto" />  <!-- Continuous Loop Button -->
                                            <ColumnDefinition Width="Auto" />  <!-- Stop All Button -->
                                            <ColumnDefinition Width="*" />     <!-- Status Badge -->
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <Border Background="#89B4FA" Width="3" Height="16" CornerRadius="1" Margin="0,0,6,0" />
                                            <TextBlock Text="ĐIỀU KHIỂN LIÊN TỤC:" Foreground="#CDD6F4" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" Text="Từ:" Foreground="#A6ADC8" FontWeight="SemiBold" FontSize="11"
                                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <ComboBox Grid.Column="2" ItemsSource="{Binding AvailableLightChannels}"
                                                  SelectedItem="{Binding ContinuousStartChannel, Mode=TwoWay}"
                                                  ItemStringFormat="CH{0}" VerticalAlignment="Center" />

                                        <TextBlock Grid.Column="3" Text="Đến:" Foreground="#A6ADC8" FontWeight="SemiBold" FontSize="11"
                                                   VerticalAlignment="Center" Margin="10,0,6,0" />
                                        <ComboBox Grid.Column="4" ItemsSource="{Binding AvailableLightChannels}"
                                                  SelectedItem="{Binding ContinuousEndChannel, Mode=TwoWay}"
                                                  ItemStringFormat="CH{0}" VerticalAlignment="Center" />

                                        <TextBlock Grid.Column="5" Text="Chu kỳ:" Foreground="#A6ADC8" FontWeight="SemiBold" FontSize="11"
                                                   VerticalAlignment="Center" Margin="10,0,6,0" />
                                        <TextBox Grid.Column="6" Text="{Binding LoopIntervalMs, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="#1E1E2E" Foreground="#CDD6F4" BorderBrush="#45475A" BorderThickness="1"
                                                 Padding="6,3" FontSize="11" VerticalAlignment="Center" FontFamily="Consolas"
                                                 HorizontalContentAlignment="Center" ToolTip="Thời gian sáng mỗi kênh (1 - 10000 ms)" />
                                        <TextBlock Grid.Column="7" Text="ms" Foreground="#585B70" FontSize="11" VerticalAlignment="Center" Margin="4,0,12,0" />

                                        <Button Grid.Column="8" Content="{Binding ContinuousRangeButtonText}" Command="{Binding ToggleContinuousRangeCommand}"
                                                Background="{Binding IsContinuousRangeOn, Converter={StaticResource BoolToColor}}"
                                                Foreground="White" FontWeight="Bold" Padding="12,5" FontSize="11" Margin="2,0"
                                                BorderBrush="#45475A" BorderThickness="1" Cursor="Hand"
                                                ToolTip="Bật sáng đồng thời các kênh đã chọn theo độ sáng setup" />

                                        <Button Grid.Column="9" Content="{Binding ContinuousLoopButtonText}" Command="{Binding ToggleContinuousLoopCommand}"
                                                Background="{Binding IsLoopRunning, Converter={StaticResource BoolToOrangeColor}}"
                                                Foreground="White" FontWeight="Bold" Padding="12,5" FontSize="11" Margin="2,0"
                                                BorderBrush="#45475A" BorderThickness="1" Cursor="Hand"
                                                ToolTip="Chạy vòng lặp sáng tuần tự từng kênh liên tục theo chu kỳ thời gian (ms)" />

                                        <Button Grid.Column="10" Content="⏹ DỪNG TẤT CẢ" Command="{Binding StopContinuousLightCommand}"
                                                Style="{StaticResource DisconnectButton}" Padding="10,5" FontSize="11" Margin="4,0,8,0"
                                                ToolTip="Dừng ngay vòng lặp và tắt toàn bộ đèn liên tục" />

                                        <Border Grid.Column="11" Background="#181825" CornerRadius="4" Padding="8,4" VerticalAlignment="Center" HorizontalAlignment="Right"
                                                BorderBrush="#313244" BorderThickness="1">
                                            <TextBlock Text="{Binding ContinuousStatusText}" FontSize="11" FontWeight="SemiBold" Foreground="#89B4FA" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- 8 Channels Grid -->
                                <ItemsControl Grid.Row="3" ItemsSource="{Binding LightChannels}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="8" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#1E1E2E" CornerRadius="6" Margin="3" Padding="8,6"
                                                    BorderBrush="#313244" BorderThickness="1">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />  <!-- Name -->
                                                        <RowDefinition Height="Auto" />  <!-- Intensity Value -->
                                                        <RowDefinition Height="Auto" />  <!-- Slider -->
                                                        <RowDefinition Height="Auto" />  <!-- Toggle Button -->
                                                    </Grid.RowDefinitions>

                                                    <!-- Channel Name -->
                                                    <TextBlock Grid.Row="0" Text="{Binding Name}" FontWeight="Bold" FontSize="12"
                                                               Foreground="#CDD6F4" HorizontalAlignment="Center" />

                                                    <!-- Intensity Number -->
                                                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,4">
                                                        <TextBlock Text="{Binding Intensity}" FontSize="15" FontWeight="Bold" Foreground="#89B4FA" />
                                                        <TextBlock Text="/255" FontSize="10" Foreground="#585B70" VerticalAlignment="Bottom" Margin="1,0,0,2" />
                                                    </StackPanel>

                                                    <!-- Slider (0-255) -->
                                                    <Slider Grid.Row="2" Minimum="0" Maximum="255" Value="{Binding Intensity, Mode=TwoWay}"
                                                            SmallChange="1" LargeChange="10" Margin="2,2,2,6" />

                                                    <!-- Toggle Button -->
                                                    <Button Grid.Row="3" Command="{Binding ToggleCommand}"
                                                            Background="{Binding IsOn, Converter={StaticResource BoolToColor}}"
                                                            Foreground="White" FontWeight="Bold" FontSize="11" Padding="4,4"
                                                            Content="{Binding IsOn, Converter={StaticResource BoolToOnOffText}}"
                                                            BorderBrush="#45475A" BorderThickness="1" Cursor="Hand" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </TabItem>

                    <!-- Tab 2: PLC LS Control & Manual Test -->
                    <TabItem Header="⚡ PLC LS CONTROL &amp; MANUAL TEST">
                        <Border Background="#181825" CornerRadius="0,8,8,8" Padding="14,10"
                                BorderBrush="#313244" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />  <!-- Header: Model, Protocol, Connection -->
                                    <RowDefinition Height="Auto" />  <!-- Network: IP / Port / Ping / Save -->
                                    <RowDefinition Height="Auto" />  <!-- Config warning if placeholder -->
                                    <RowDefinition Height="Auto" />  <!-- Manual Test Controls -->
                                    <RowDefinition Height="Auto" />  <!-- Result Bar -->
                                </Grid.RowDefinitions>

                                <!-- Row 0: PLC Header & Quick Connection -->
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="⚡ PLC LS" FontSize="14" FontWeight="Bold" Foreground="#CDD6F4" />
                                        <Border Background="#313244" CornerRadius="4" Padding="6,2" Margin="8,0">
                                            <TextBlock Text="{Binding PlcModel}" FontSize="11" FontWeight="Bold" Foreground="#89B4FA" />
                                        </Border>
                                        <Border Background="#313244" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding PlcProtocol}" FontSize="11" FontWeight="SemiBold" Foreground="#A6ADC8" />
                                        </Border>
                                        <Ellipse Style="{StaticResource StatusDot}" Fill="{Binding PlcStatus, Converter={StaticResource StatusToColor}}" />
                                        <TextBlock Text="{Binding PlcStatus, Converter={StaticResource StatusToText}}"
                                                   FontSize="11" FontWeight="Bold" Foreground="#A6ADC8" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="🔌 CONNECT PLC" Command="{Binding ConnectPlcCommand}"
                                                Style="{StaticResource ConnectButton}" Padding="10,4" FontSize="11" Margin="2" />
                                        <Button Content="⏹ DISCONNECT" Command="{Binding DisconnectPlcCommand}"
                                                Style="{StaticResource DisconnectButton}" Padding="10,4" FontSize="11" Margin="2" />
                                        <Button Content="⚡ TRIGGER CYCLE" Command="{Binding SimulatePlcTriggerCommand}"
                                                Style="{StaticResource HmiButton}" Padding="10,4" FontSize="11" Margin="2" />
                                    </StackPanel>
                                </Grid>

                                <!-- Row 1: PLC Network Settings & Ping Bar (IP is typed here, never hardcoded) -->
                                <Border Grid.Row="1" Background="#11111B" CornerRadius="6" Padding="10,6" Margin="0,0,0,8"
                                        BorderBrush="#313244" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="PLC IP:" Foreground="#A6ADC8" FontWeight="SemiBold" FontSize="12"
                                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBox Grid.Column="1" Text="{Binding PlcIpAddress, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="#1E1E2E" Foreground="#CDD6F4" BorderBrush="#45475A" BorderThickness="1"
                                                 Padding="6,3" FontSize="12" VerticalAlignment="Center" FontFamily="Consolas" />

                                        <TextBlock Grid.Column="2" Text="Port:" Foreground="#A6ADC8" FontWeight="SemiBold" FontSize="12"
                                                   VerticalAlignment="Center" Margin="12,0,6,0" />
                                        <TextBox Grid.Column="3" Text="{Binding PlcPort, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="#1E1E2E" Foreground="#CDD6F4" BorderBrush="#45475A" BorderThickness="1"
                                                 Padding="6,3" FontSize="12" VerticalAlignment="Center" FontFamily="Consolas" />

                                        <Button Grid.Column="4" Content="📡 PING" Command="{Binding PingPlcCommand}"
                                                Style="{StaticResource HmiButton}" Padding="10,4" FontSize="11" Margin="10,0,6,0" />

                                        <Border Grid.Column="5" Background="{Binding IsPlcPingSuccess, Converter={StaticResource NullableBoolToColor}}"
                                                CornerRadius="4" Padding="8,4" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding PlcPingResultText}" FontSize="11" FontWeight="Bold" Foreground="White" />
                                        </Border>

                                        <Button Grid.Column="6" Content="💾 SAVE IP" Command="{Binding SavePlcSettingsCommand}"
                                                Style="{StaticResource HmiButton}" Padding="10,4" FontSize="11" Margin="2,0" />

                                        <TextBlock Grid.Column="7" Text="XGT Dedicated (FEnet) TCP" Foreground="#585B70" FontSize="11"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0" />
                                    </Grid>
                                </Border>

                                <!-- Row 2: Warning banner if incomplete -->
                                <Border Grid.Row="2" Background="#261B00" BorderBrush="#F57F17" BorderThickness="1" CornerRadius="6"
                                        Padding="10,6" Margin="0,0,0,8"
                                        Visibility="{Binding IsPlcConfigured, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚠ " FontSize="13" Foreground="#FFD54F" FontWeight="Bold" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding PlcConfigWarning}" FontSize="11" Foreground="#FFE082" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- Row 3: Manual Read / Write Tool (address is typed by the user, full XGT variable name) -->
                                <Border Grid.Row="3" Background="#11111B" CornerRadius="6" Padding="10,8" Margin="0,0,0,8"
                                        BorderBrush="#313244" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" /> <!-- Row label -->
                                            <ColumnDefinition Width="220" />  <!-- Main input -->
                                            <ColumnDefinition Width="Auto" /> <!-- Extra (string length) -->
                                            <ColumnDefinition Width="Auto" /> <!-- Buttons -->
                                            <ColumnDefinition Width="*" />    <!-- Hint -->
                                        </Grid.ColumnDefinitions>

                                        <!-- Address -->
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Address:" Foreground="#A6ADC8" FontWeight="SemiBold"
                                                   FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding PlcTestAddress, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="#1E1E2E" Foreground="#CDD6F4" BorderBrush="#45475A" BorderThickness="1"
                                                 Padding="6,3" FontSize="12" VerticalAlignment="Center" FontFamily="Consolas" />
                                        <TextBlock Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="3"
                                                   Text="Full XGT variable name, e.g. %MX.. (bit), %MW.. / %DW.. (word)"
                                                   Foreground="#585B70" FontSize="10" VerticalAlignment="Center" Margin="10,0,0,0" />

                                        <!-- Bit -->
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Bit:" Foreground="#A6ADC8" FontWeight="SemiBold"
                                                   FontSize="12" VerticalAlignment="Center" Margin="0,8,8,0" />
                                        <CheckBox Grid.Row="1" Grid.Column="1" Content="Value = 1 (ON)" IsChecked="{Binding PlcTestBitValue}"
                                                  Foreground="#CDD6F4" FontSize="12" VerticalAlignment="Center" Margin="0,8,0,0" />
                                        <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" Margin="10,8,0,0">
                                            <Button Content="Read Bit" Command="{Binding ReadPlcBitCommand}"
                                                    Style="{StaticResource HmiButton}" Padding="8,4" FontSize="11" Margin="2,0" />
                                            <Button Content="Write Bit" Command="{Binding WritePlcBitCommand}"
                                                    Style="{StaticResource HmiButton}" Padding="8,4" FontSize="11" Margin="2,0" />
                                        </StackPanel>

                                        <!-- Word -->
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Word:" Foreground="#A6ADC8" FontWeight="SemiBold"
                                                   FontSize="12" VerticalAlignment="Center" Margin="0,8,8,0" />
                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding PlcTestWordValue, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="#1E1E2E" Foreground="#CDD6F4" BorderBrush="#45475A" BorderThickness="1"
                                                 Padding="6,3" FontSize="12" VerticalAlignment="Center" FontFamily="Consolas" Margin="0,8,0,0" />
                                        <StackPanel Grid.Row="2" Grid.Column="3" Orientation="Horizontal" Margin="10,8,0,0">
                                            <Button Content="Read Word" Command="{Binding ReadPlcWordCommand}"
                                                    Style="{StaticResource HmiButton}" Padding="8,4" FontSize="11" Margin="2,0" />
                                            <Button Content="Write Word" Command="{Binding WritePlcWordCommand}"
                                                    Style="{StaticResource HmiButton}" Padding="8,4" FontSize="11" Margin="2,0" />
                                        </StackPanel>

                                        <!-- String -->
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="String:" Foreground="#A6ADC8" FontWeight="SemiBold"
                                                   FontSize="12" VerticalAlignment="Center" Margin="0,8,8,0" />
                                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding PlcTestStringValue, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="#1E1E2E" Foreground="#CDD6F4" BorderBrush="#45475A" BorderThickness="1"
                                                 Padding="6,3" FontSize="12" VerticalAlignment="Center" FontFamily="Consolas" Margin="0,8,0,0" />
                                        <StackPanel Grid.Row="3" Grid.Column="2" Orientation="Horizontal" Margin="8,8,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Len:" Foreground="#A6ADC8" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0" />
                                            <TextBox Text="{Binding PlcTestStringLength, UpdateSourceTrigger=PropertyChanged}" Width="40"
                                                     Background="#1E1E2E" Foreground="#CDD6F4" BorderBrush="#45475A" BorderThickness="1"
                                                     Padding="6,3" FontSize="12" FontFamily="Consolas" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="3" Grid.Column="3" Orientation="Horizontal" Margin="10,8,0,0">
                                            <Button Content="Read Str" Command="{Binding ReadPlcStringCommand}"
                                                    Style="{StaticResource HmiButton}" Padding="8,4" FontSize="11" Margin="2,0" />
                                            <Button Content="Write Str" Command="{Binding WritePlcStringCommand}"
                                                    Style="{StaticResource HmiButton}" Padding="8,4" FontSize="11" Margin="2,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Row 4: Result Feedback & Live Address Indicators -->
                                <Border Grid.Row="4" Background="#11111B" CornerRadius="6" Padding="10,6"
                                        BorderBrush="#313244" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="Manual Test Result:" Foreground="#A6ADC8" FontWeight="SemiBold" FontSize="11"
                                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding PlcTestResult}" Foreground="#89B4FA"
                                                   FontFamily="Consolas" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />

                                        <TextBlock Grid.Column="2" Text="Addresses: READY • TRG • BUSY • CAPT • OK • NG • ERR • RESET • RESULT"
                                                   Foreground="#585B70" FontSize="10" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </TabItem>
                </TabControl>
            </Grid>

            <!-- ── Right Panel ── -->
            <Grid Grid.Column="1" Margin="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />     <!-- Connection Status -->
                    <RowDefinition Height="Auto" />     <!-- PLC Handshake Signals -->
                    <RowDefinition Height="Auto" />     <!-- Inspection Result -->
                    <RowDefinition Height="Auto" />     <!-- Controls -->
                    <RowDefinition Height="Auto" />     <!-- Statistics -->
                    <RowDefinition Height="*" />        <!-- Log -->
                </Grid.RowDefinitions>

                <!-- ── Connection Status Panel ── -->
                <Border Grid.Row="0" Background="#181825" CornerRadius="8" Padding="14,10" Margin="0,0,0,6"
                        BorderBrush="#313244" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="CONNECTION STATUS" FontSize="12" FontWeight="Bold"
                                   Foreground="#A6ADC8" Margin="0,0,0,8" />

                        <!-- PLC Status -->
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Style="{StaticResource StatusDot}"
                                     Fill="{Binding PlcStatus, Converter={StaticResource StatusToColor}}" />
                            <TextBlock Grid.Column="1" Text="PLC LS" Foreground="#CDD6F4" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="{Binding PlcStatus, Converter={StaticResource StatusToText}}"
                                       Foreground="#A6ADC8" FontSize="11" HorizontalAlignment="Right" />
                        </Grid>

                        <!-- Camera Status -->
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Style="{StaticResource StatusDot}"
                                     Fill="{Binding CameraStatus, Converter={StaticResource StatusToColor}}" />
                            <TextBlock Grid.Column="1" Text="CAMERA" Foreground="#CDD6F4" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="{Binding CameraStatus, Converter={StaticResource StatusToText}}"
                                       Foreground="#A6ADC8" FontSize="11" HorizontalAlignment="Right" />
                        </Grid>

                        <!-- Light Status -->
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Style="{StaticResource StatusDot}"
                                     Fill="{Binding LightStatus, Converter={StaticResource StatusToColor}}" />
                            <TextBlock Grid.Column="1" Text="LIGHT" Foreground="#CDD6F4" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="{Binding LightStatus, Converter={StaticResource StatusToText}}"
                                       Foreground="#A6ADC8" FontSize="11" HorizontalAlignment="Right" />
                        </Grid>

                        <!-- OCR Status -->
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Style="{StaticResource StatusDot}"
                                     Fill="{Binding OcrStatus, Converter={StaticResource StatusToColor}}" />
                            <TextBlock Grid.Column="1" Text="OCR" Foreground="#CDD6F4" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="{Binding OcrStatus, Converter={StaticResource StatusToText}}"
                                       Foreground="#A6ADC8" FontSize="11" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── PLC Real-Time Handshake Monitor Panel ── -->
                <Border Grid.Row="1" Background="#181825" CornerRadius="8" Padding="14,10" Margin="0,0,0,6"
                        BorderBrush="#313244" BorderThickness="1">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="PLC SIGNALS" FontSize="12" FontWeight="Bold" Foreground="#A6ADC8" />
                            <TextBlock Grid.Column="1" Text="REAL-TIME I/O" FontSize="10" FontWeight="Bold" Foreground="#89B4FA" />
                        </Grid>

                        <!-- Handshake 8-Signal Grid (2x4) -->
                        <UniformGrid Columns="4" Rows="2">
                            <!-- READY -->
                            <Border Background="{Binding PlcReadyFlag, Converter={StaticResource BoolToColor}}"
                                    CornerRadius="4" Padding="4,4" Margin="2" ToolTip="PC Ready (asserted when idle waiting for part)">
                                <TextBlock Text="READY" FontSize="10" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
                            </Border>

                            <!-- TRIGGER -->
                            <Border Background="{Binding PlcTriggerFlag, Converter={StaticResource BoolToOrangeColor}}"
                                    CornerRadius="4" Padding="4,4" Margin="2" ToolTip="PLC Trigger (Rising Edge 0->1)">
                                <TextBlock Text="TRG" FontSize="10" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
                            </Border>

                            <!-- BUSY -->
                            <Border Background="{Binding PlcBusyFlag, Converter={StaticResource BoolToBlueColor}}"
                                    CornerRadius="4" Padding="4,4" Margin="2" ToolTip="PC Busy (Cycle in progress)">
                                <TextBlock Text="BUSY" FontSize="10" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
                            </Border>

                            <!-- CAPTURE COMPLETE -->
                            <Border Background="{Binding PlcCaptureCompleteFlag, Converter={StaticResource BoolToCyanColor}}"
                                    CornerRadius="4" Padding="4,4" Margin="2" ToolTip="Capture Complete (Part can move)">
                                <TextBlock Text="CAPT" FontSize="10" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
                            </Border>

                            <!-- OK -->
                            <Border Background="{Binding PlcOkFlag, Converter={StaticResource BoolToColor}}"
                                    CornerRadius="4" Padding="4,4" Margin="2" ToolTip="Product Passed (OK)">
                                <TextBlock Text="OK" FontSize="10" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
                            </Border>

                            <!-- NG -->
                            <Border Background="{Binding PlcNgFlag, Converter={StaticResource BoolToRedColor}}"
                                    CornerRadius="4" Padding="4,4" Margin="2" ToolTip="Product Failed (NG)">
                                <TextBlock Text="NG" FontSize="10" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
                            </Border>

                            <!-- ERROR -->
                            <Border Background="{Binding PlcErrorFlag, Converter={StaticResource BoolToRedColor}}"
                                    CornerRadius="4" Padding="4,4" Margin="2" ToolTip="System Alarm / Handshake Error">
                                <TextBlock Text="ERR" FontSize="10" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
                            </Border>

                            <!-- HEARTBEAT -->
                            <Border Background="{Binding PlcHeartbeatFlag, Converter={StaticResource BoolToColor}}"
                                    CornerRadius="4" Padding="4,4" Margin="2" ToolTip="Heartbeat Alive Signal">
                                <TextBlock Text="BEAT" FontSize="10" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- ── Inspection Result Panel ── -->
                <Border Grid.Row="2" Background="#181825" CornerRadius="8" Padding="14,10" Margin="0,0,0,6"
                        BorderBrush="#313244" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="INSPECTION RESULT" FontSize="12" FontWeight="Bold"
                                   Foreground="#A6ADC8" Margin="0,0,0,8" />

                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="OCR:" Foreground="#A6ADC8" FontSize="13" />
                            <TextBlock Grid.Column="1" Text="{Binding OcrResultText}"
                                       Foreground="#CDD6F4" FontSize="15" FontWeight="Bold" FontFamily="Consolas" />
                        </Grid>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="RESULT:" Foreground="#A6ADC8" FontSize="13" />
                            <TextBlock Grid.Column="1" Text="{Binding LastResult}"
                                       Foreground="{Binding LastResult, Converter={StaticResource ResultToColor}}"
                                       FontSize="20" FontWeight="Bold" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── Control Buttons ── -->
                <Border Grid.Row="3" Background="#181825" CornerRadius="8" Padding="12,8" Margin="0,0,0,6"
                        BorderBrush="#313244" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="CONTROLS" FontSize="12" FontWeight="Bold"
                                   Foreground="#A6ADC8" Margin="0,0,0,6" />

                        <!-- Connect / Disconnect -->
                        <WrapPanel>
                            <Button Content="▶ CONNECT ALL" Command="{Binding ConnectAllCommand}"
                                    Style="{StaticResource ConnectButton}" Padding="10,5" FontSize="11" Margin="2" />
                            <Button Content="■ DISCONNECT ALL" Command="{Binding DisconnectAllCommand}"
                                    Style="{StaticResource DisconnectButton}" Padding="10,5" FontSize="11" Margin="2" />
                        </WrapPanel>

                        <!-- Inspection Cycle Controls -->
                        <WrapPanel Margin="0,2,0,0">
                            <Button Content="⚡ TRIGGER ONCE" Command="{Binding SimulatePlcTriggerCommand}"
                                    Style="{StaticResource HmiButton}" Background="#3949AB" Padding="10,5" FontSize="11" Margin="2" />
                            <Button Content="🚀 AUTO" Command="{Binding StartAutoInspectionCommand}"
                                    Style="{StaticResource ConnectButton}" Padding="10,5" FontSize="11" Margin="2" />
                            <Button Content="⏹ MANUAL" Command="{Binding StopAutoInspectionCommand}"
                                    Style="{StaticResource DisconnectButton}" Padding="10,5" FontSize="11" Margin="2" />
                        </WrapPanel>

                        <!-- Camera & Reset Controls -->
                        <WrapPanel Margin="0,2,0,0">
                            <Button Content="📷 LIVE" Command="{Binding StartLiveCommand}"
                                    Style="{StaticResource HmiButton}" Padding="8,4" FontSize="11" Margin="2" />
                            <Button Content="⏹ STOP" Command="{Binding StopLiveCommand}"
                                    Style="{StaticResource HmiButton}" Padding="8,4" FontSize="11" Margin="2" />
                            <Button Content="📸 CAPTURE" Command="{Binding CaptureCommand}"
                                    Style="{StaticResource HmiButton}" Padding="8,4" FontSize="11" Margin="2" />
                            <Button Content="🔄 RESET" Command="{Binding ResetCommand}"
                                    Style="{StaticResource HmiButton}" Padding="8,4" FontSize="11" Margin="2" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- ── Statistics ── -->
                <Border Grid.Row="4" Background="#181825" CornerRadius="8" Padding="12,8" Margin="0,0,0,6"
                        BorderBrush="#313244" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="TOTAL" Foreground="#A6ADC8" FontSize="10" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding CycleCount}" Foreground="#CDD6F4"
                                       FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock Text="OK" Foreground="#4CAF50" FontSize="10" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding OkCount}" Foreground="#4CAF50"
                                       FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock Text="NG" Foreground="#F44336" FontSize="10" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding NgCount}" Foreground="#F44336"
                                       FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ── Log Output ── -->
                <Border Grid.Row="5" Background="#11111B" CornerRadius="8" Padding="8" Margin="0,0,0,0"
                        BorderBrush="#313244" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="LOG" FontSize="11" FontWeight="Bold"
                                   Foreground="#585B70" Margin="4,0,0,4" />
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding LogText}" Foreground="#A6ADC8"
                                       FontFamily="Consolas" FontSize="11"
                                       TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ═══ STATUS BAR ═══ -->
        <Border Grid.Row="2" Background="#16161E" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding StatusMessage}" Foreground="#A6ADC8" FontSize="12"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="Mode: " Foreground="#585B70" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding OperationMode}" Foreground="#CDD6F4"
                               FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
